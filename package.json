{
  "name": "kettlebell-bot",
  "version": "2.1.0",
  "private": true,
  "description": "An expressive Rive character for a bot, with moods, reactions, gaze and a 360-degree turn.",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "node scripts/build-svg.mjs && node scripts/build-rive.mjs",
    "build:svg": "node scripts/build-svg.mjs",
    "build:riv": "node scripts/build-rive.mjs",
    "build:icon": "node scripts/build-icon.mjs",
    "check": "node scripts/build-rive.mjs --dry",
    "verify": "node scripts/verify-asset.mjs",
    "previews": "node scripts/render-previews.mjs",
    "sheets": "node scripts/build-sheets.mjs",
    "review": "node scripts/render-expansion-review.mjs",
    "test": "node scripts/test-scene.mjs && node scripts/test-state-machine.mjs",
    "critique": "node scripts/critique-motion.mjs",
    "lint:riv": "node scripts/rive-mcp-client.mjs call riv_lint '{\"path\":\"rive/kettlebell-bot.riv\"}'",
    "inspect:riv": "node scripts/rive-mcp-client.mjs call riv_inspect '{\"path\":\"rive/kettlebell-bot.riv\"}'",
    "studio": "node scripts/start-studio.mjs",
    "playground": "npm --prefix playground run dev",
    "playground:build": "npm --prefix playground run build",
    "all": "npm run build && npm run test && npm run previews && npm run sheets"
  }
}
